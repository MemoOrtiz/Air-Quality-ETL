# ---- OpenAQ API (required) ----
# Get your API key at: https://openaq.org/#/register
OPENAQ_API_KEY=your_api_key_here
API_BASE=https://api.openaq.org/v3

# ---- Local storage (required) ----
# Directory where the Bronze layer is written
OUT_DIR=./bronze

# ---- AWS S3 (optional) ----
# Setting AWS_S3_BUCKET_NAME switches the storage backend to S3 automatically.
# AWS_S3_BUCKET_NAME=your-bucket-name
# AWS_S3_PREFIX=bronze

# Credentials are read by boto3 from the environment. Known trade-off:
# on EC2/ECS the correct approach is an IAM Role, not static keys.
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=us-east-1
